/* ==========================================================================
   FolioHaven Reader: Qt 6 Style Sheet (QSS)
   Generated by replica-brand
   All colors mapped directly from replica/design/tokens.json
   ========================================================================== */

/* --- General Application Shell --- */
QMainWindow, QDialog {
    background-color: #ffffff;
    color: #14181f;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 14px;
}

QWidget#CentralLibraryWidget {
    background-color: #f5f7fa;
}

/* --- Left Sidebar (Desktop Navigation) --- */
QWidget#SideBar {
    background-color: #231f1d;
    border-right: 1px solid #756b62;
    min-width: 220px;
    max-width: 220px;
}

QWidget#SideBar QLabel#BrandTitle {
    color: #f0f3f8;
    font-size: 16px;
    font-weight: 700;
    padding: 16px 16px 12px 16px;
}

QListWidget#SideBarCategoryList {
    background-color: transparent;
    border: none;
    outline: none;
    color: #a89f97;
    font-size: 14px;
}

QListWidget#SideBarCategoryList::item {
    height: 38px;
    padding-left: 14px;
    border-radius: 5px;
    margin: 2px 8px;
}

QListWidget#SideBarCategoryList::item:hover {
    background-color: #2c2724;
    color: #f0f3f8;
}

QListWidget#SideBarCategoryList::item:selected {
    background-color: #c2410c;
    color: #ffffff;
    font-weight: 600;
}

/* --- Top Action Toolbar --- */
QToolBar#LibraryHeaderBar {
    background-color: #ffffff;
    border-bottom: 1px solid #dbe0e8;
    spacing: 8px;
    padding: 8px 16px;
    min-height: 56px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #f5f7fa;
    color: #14181f;
    border: 1px solid #dbe0e8;
    border-radius: 5px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #ebf0f5;
    border-color: #6c7684;
}

QPushButton:pressed {
    background-color: #e0e6ed;
}

QPushButton:disabled {
    background-color: #f5f7fa;
    color: #525b6a;
    border-color: #dbe0e8;
}

/* Primary Accent Button ("+ Add Book", "Start Reading") */
QPushButton#BtnPrimary {
    background-color: #c2410c;
    color: #ffffff;
    border: 1px solid #c2410c;
    font-weight: 600;
}

QPushButton#BtnPrimary:hover {
    background-color: #9a3412;
    border-color: #9a3412;
}

QPushButton#BtnPrimary:pressed {
    background-color: #133c8c;
}

/* Danger Button ("Delete Book") */
QPushButton#BtnDanger {
    background-color: #ffffff;
    color: #c92a2a;
    border: 1px solid #c92a2a;
}

QPushButton#BtnDanger:hover {
    background-color: #c92a2a;
    color: #ffffff;
}

/* --- Text Input Fields --- */
QLineEdit {
    background-color: #ffffff;
    color: #14181f;
    border: 1px solid #6c7684;
    border-radius: 5px;
    padding: 6px 12px;
    font-size: 13px;
    selection-background-color: #c2410c;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 2px solid #c2410c;
    padding: 5px 11px;
}

QLineEdit:disabled {
    background-color: #f5f7fa;
    color: #525b6a;
}

/* --- Table View (Library Catalog S01B) --- */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f5f7fa;
    gridline-color: #dbe0e8;
    border: none;
    color: #14181f;
    selection-background-color: #c2410c;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #f5f7fa;
    color: #525b6a;
    border: none;
    border-bottom: 1px solid #dbe0e8;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* --- ScrollBars (Clean Overlay Style) --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #6c7684;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #525b6a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

/* --- Reader Toolbar & Scrubber Footer --- */
QToolBar#ReadingToolBar {
    background-color: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #dbe0e8;
    padding: 4px 12px;
}

QWidget#ReadingFooterBar {
    background-color: rgba(255, 255, 255, 0.95);
    border-top: 1px solid #dbe0e8;
    min-height: 40px;
}

/* Scrubber Slider */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #dbe0e8;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #c2410c;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #c2410c;
    border: 2px solid #ffffff;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #9a3412;
    width: 16px;
    margin-top: -6px;
    margin-bottom: -6px;
    border-radius: 8px;
}

/* --- Progress Bar --- */
QProgressBar {
    border: none;
    background-color: #dbe0e8;
    border-radius: 2px;
    text-align: center;
    color: #14181f;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #1b7a4b;
    border-radius: 2px;
}

/* --- Context Menus & ToolTips --- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #dbe0e8;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    color: #14181f;
}

QMenu::item:selected {
    background-color: #ebf0f5;
    color: #c2410c;
}

QToolTip {
    background-color: #231f1d;
    color: #f0f3f8;
    border: 1px solid #756b62;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}
